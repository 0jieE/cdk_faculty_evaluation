# Copy to .env and fill in. .env is read by core/settings.py and serve.py.

# Django
# Generate a key: .venv\Scripts\python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,evaluation.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://evaluation.example.edu
# True when users reach the site over https:// (through IIS)
DJANGO_HTTPS=False

# PostgreSQL
DB_NAME=fe_database
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Waitress (serve.py). Keep it on 127.0.0.1 behind IIS.
# CONNECTION_LIMIT must stay below ~500 on Windows (select() limit; above it Waitress crashes).
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8000
WAITRESS_THREADS=8
WAITRESS_CONNECTION_LIMIT=400
WAITRESS_CHANNEL_TIMEOUT=30

